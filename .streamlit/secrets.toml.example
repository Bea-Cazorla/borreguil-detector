# Renombra a secrets.toml para uso LOCAL con service account (NO lo subas a git).
# En Streamlit Cloud / HuggingFace, pega esto en el panel de Secrets.
#
# Solo necesario si quieres usar el backend Google Earth Engine en un
# despliegue headless (sin navegador). Para uso local con --auth no hace falta.

GEE_PROJECT = "ee-tunombre"

EE_SERVICE_ACCOUNT_KEY = '''
{
  "type": "service_account",
  "project_id": "ee-tunombre",
  "private_key_id": "xxxxxxxxxxxxxxxxxxxx",
  "private_key": "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n",
  "client_email": "borreguil@ee-tunombre.iam.gserviceaccount.com",
  "client_id": "1234567890",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/borreguil%40ee-tunombre.iam.gserviceaccount.com"
}
'''
